# Dependencias
node_modules/

# Variables de entorno (usar .env.example como plantilla)
.env
.env.*
!.env.example

# Certificados y llaves privadas (nunca se versionan; se montan desde el entorno)
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.jks
.pgpass

# Build / compilación
dist/
build/
out/
*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Prisma (cliente generado vive en node_modules; migraciones sí van al repo)
prisma/*.db
prisma/*.db-journal

# Cobertura y pruebas
coverage/
.nyc_output/

# Caché de herramientas
.cache/
.turbo/
.eslintcache
.parcel-cache/

# Docker (datos locales, no el compose ni scripts SQL)
docker-data/

# IDE / editor
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*~

# Sistema operativo
Thumbs.db
ehthumbs.db
Desktop.ini
.DS_Store

# Sistema operativo y editores (configuración compartida de VS Code permitida)
[Dd]esktop.ini
.vs/
*.user
*.suo

# Logs, temporales y respaldos
*.tmp
*.bak
*.orig
*.rej

# Volcados y respaldos de base de datos (nunca se versionan)
*.dump
*.backup

# Resultados de pruebas y caché del compilador SWC
TestResults/
.swc/
