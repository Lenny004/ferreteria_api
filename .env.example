DATABASE_URL="postgresql://ferreteria_user:ferreteria_dev_password@localhost:55432/ferreteria"
POSTGRES_DB="ferreteria"
POSTGRES_USER="ferreteria_user"
POSTGRES_PASSWORD="ferreteria_dev_password"
POSTGRES_PORT="55432"

PORT=3001
JWT_SECRET="cambiar-en-produccion-ferreteria-jwt-secret-min-32"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV="development"
# Zona horaria del negocio para cortes de día/semana/mes en dashboard y reportes (IANA, sin DST en SV)
BUSINESS_TZ="America/El_Salvador"
COOKIE_DOMAIN=""
COOKIE_SECURE="false"
COOKIE_SAMESITE="lax"
EXPOSE_RESET_TOKEN_IN_DEV="false"

# Seed demo recomendado solo para desarrollo local; en producción debe ser false o quedar ausente.
# SEED_DEMO="true"
# Admin inicial opcional para producción: se crea solo si el usuario todavía no existe.
# La contraseña debe tener al menos 12 caracteres y no puede ser admin123.
SEED_ADMIN_USER=""
SEED_ADMIN_PASSWORD=""
# Correo opcional del admin inicial; por defecto `${SEED_ADMIN_USER}@ferreteria.local`.
SEED_ADMIN_EMAIL=""

# Datos de la empresa para exports de planilla (opcionales, default "Ferretería")
COMPANY_NAME="Ferretería"
COMPANY_NIT=""
COMPANY_ADDRESS=""

# URLs de front para enlaces de reset de contraseña
ADMIN_APP_URL="http://localhost:3000"
SHOP_APP_URL="http://localhost:3000/tienda"

# SMTP opcional (si falta, forgot-password solo registra en consola / expone token en development)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Ferreteria <noreply@ferreteria.local>"
